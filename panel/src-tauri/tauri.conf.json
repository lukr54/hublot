{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hublot",
  "version": "0.1.0",
  "identifier": "fr.nexalit.hublot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "hublot",
        "width": 900,
        "height": 540,
        "minWidth": 420,
        "minHeight": 240,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Nexalit",
    "category": "Utility",
    "shortDescription": "A porthole onto a machine you're not inside.",
    "longDescription": "hublot mirrors the console of another machine into a hotkey-summoned window and types back into it. Ships with the Windows desktop agent, so a second PC can be mirrored too.",
    "copyright": "Copyright (c) 2026 Nexalit",
    "resources": {
      "../../target/release/win-agent.exe": "win-agent.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
